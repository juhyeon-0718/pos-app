ENV=dev
# D-21: PostgreSQL 18 전용 (16→18 변경, 2026-10-16). pos_app_dev / pos_app_test는 호스트에 직접 설치.
# 개발·테스트·운영 모두 PostgreSQL 18(18.x 최신 마이너)을 쓴다.
DATABASE_URL=postgresql+psycopg2://pos_app:CHANGE_ME@localhost:5432/pos_app_dev
SEED=42
# B-05: JWT 서명 비밀값. dev/test는 생략 가능(기본값 사용), 그 외 ENV는 필수.
JWT_SECRET=CHANGE_ME_IN_PROD
